generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum QuizStatus {
  Draft
  Published
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model Quiz {
  id           String     @id @default(cuid())
  title        String
  description  String?    @db.Text
  category     String
  difficulty   Difficulty @default(Medium)
  
  // Các cài đặt từ Step 1 FE
  timeLimit    Int        @default(15) // phút
  passingScore Int        @default(70) // %
  randomize    Boolean    @default(false)
  
  status       QuizStatus @default(Draft)
  completions  Int        @default(0) // Số lượt hoàn thành hiển thị ở Library
  
  // Quan hệ
  questions    Question[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([category])
}

model Question {
  id          String       @id @default(cuid())
  text        String       @db.Text
  type        QuestionType @default(MULTIPLE_CHOICE)
  
  points      Int          @default(10)
  order     Int
  
  // Quan hệ tới Quiz
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  // Quan hệ tới các lựa chọn
  options     Option[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([quizId])
}

model Option {
  id          String   @id @default(cuid())
  text        String   @db.Text
  isCorrect   Boolean  @default(false)
  
  // Quan hệ tới Question
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}